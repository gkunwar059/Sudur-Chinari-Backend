# ==============================================================================
# Sudur Chinari Backend - Environment Configuration
# Copy this file to .env and configure before starting:
#   cp .env.example .env
# ==============================================================================

# Backend Port exposed on host (default: 8000)
BACKEND_PORT=8000

# Set to False in production
DEBUG=False

# Generate a secure secret key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-for-production-use

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=localhost,127.0.0.1,backend,sudur_backend,yourdomain.com,api.yourdomain.com

# Comma-separated list of origins trusted for CSRF (Required for Django Admin over HTTPS/domain)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://api.yourdomain.com,https://yourdomain.com

# Optional CORS allowed origins (leave empty to allow all, or restrict to frontend URL)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL is default in Docker)
# ------------------------------------------------------------------------------
DB_ENGINE=postgres
POSTGRES_DB=sudur_chinari
POSTGRES_USER=postgres
POSTGRES_PASSWORD=please_choose_a_strong_database_password_here

# To use SQLite instead:
# DB_ENGINE=sqlite
# SQLITE_PATH=/app/data/db.sqlite3

# ------------------------------------------------------------------------------
# Superuser Credentials (Automatically created on initial boot)
# ------------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=ChangeThisAdminPassword123!

# ------------------------------------------------------------------------------
# Automated Seeding
# Set to 'true' on first launch to automatically populate districts, categories,
# articles, and initial media assets.
# ------------------------------------------------------------------------------
AUTO_SEED=true

# Docker network name (shared with frontend if on the same VPS)
DOCKER_NETWORK=sudur_network
